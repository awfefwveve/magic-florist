extends SceneTree
const State = preload("res://scripts/game_state.gd")
const Legacy = preload("res://scripts/legacy_state_v1.gd")
const Store = preload("res://scripts/save_store.gd")
var checks: int = 0
var failures: int = 0

func check(ok: bool, text: String) -> void:
	checks += 1
	if not ok:
		failures+=1
		push_error("FAIL: "+text)

func arranged(s: RefCounted, ids: Array) -> void:
	s.setup("bouquet")
	for id in ids: s.place(id,Vector2(0.5,0.43))
	var indices:Array=[]
	for i in ids.size():indices.append(i)
	s.trim(indices)
	s.use_tool("wire")
	s.use_tool("ribbon")

func _initialize() -> void:
	var s=State.new()
	check(s.valid(s.snapshot()),"initial state")
	s.tick(20)
	check(s.d.elapsed==0 and s.d.phase=="ready","clock waits for manual opening")
	check(not s.accept_order() and not s.setup("bouquet"),"order and crafting gated before open")
	check(s.d.plots.size()==12 and s.d.plots.filter(func(p):return p.unlocked).size()==2,"12 plots with 2 unlocked")
	check(s.start_day() and not s.start_day(),"manual start only once")
	for i in 5:check(s.ask(),"five dialogue replies")
	check(not s.ask() and s.d.question==5,"sixth followup rejected")
	check(s.accept_order() and not s.accept_order(),"accept exactly one order")
	check(not s.place("freesia",Vector2(.2,.3)),"paper required")
	check(s.setup("bouquet"),"lay wrapping paper")
	check(not s.can_place("freesia",Vector2(.01,.01)),"off-paper drop rejected")
	var ids:Array=["freesia","freesia","lovemis","lovemis","redflora"]
	for i in ids.size(): check(s.place(ids[i],Vector2(.16+i*.16,.3)),"five flowers placed and deducted")
	check(not s.place("yellow",Vector2(.5,.43)),"sixth flower rejected")
	check(not s.use_tool("wire") and not s.use_tool("ribbon"),"wire and ribbon cannot skip trimming")
	check(s.trim([0,1,2,3,4]),"trim leaves individually")
	check(not s.use_tool("wire"),"must gather loose flowers")
	for i in 5:check(s.move_flower(i,Vector2(.5+(i-2)*.025,.43)),"gather flower")
	check(s.use_tool("wire"),"bind gathered trimmed flowers")
	check(not s.place("yellow",Vector2(.5,.43)) and not s.trim([0]),"bound arrangement locked")
	check(s.use_tool("ribbon") and s.d.craft.step=="complete","wrap and complete")
	check(s.price_details().paid==100,"correct full reward")
	check(s.deliver() and s.d.gold==260 and s.d.mastery.birthday==1,"deliver and mastery")
	check(not s.deliver() and s.d.gold==260,"duplicate payout blocked")
	check(s.d.phase=="result","result retained until acknowledgement")
	s.tick(40)
	check(s.d.elapsed==0,"result pauses clock")
	s.continue_service()
	s.tick(3)
	check(s.d.phase=="waiting","visitor gap")
	s.tick(1)
	check(s.d.phase=="talk" and s.customer().id=="amelia","next visitor after gap")
	s.accept_order()
	arranged(s,["freesia","freesia","lovemis","lovemis","redflora"])
	check(s.price_details().quality==0.8,"0-1 matches pays eighty percent")
	s.tick(31)
	check(s.patience_level()==1 and s.price_details().paid==58,"patience multiplier applies after flower match")
	check(s.deliver(),"imperfect bouquet can be sold")
	s.end_day()
	check(s.next_day() and s.d.phase=="ready" and s.d.day==2,"day transition returns to ready")
	s.start_day()
	check(s.recipe().kind=="pot","day two pot order")
	s.accept_order()
	check(s.setup("pot"),"pot unlocked")
	check(not s.place("freesia",Vector2(.5,.4)) and not s.use_tool("ribbon"),"soil required")
	check(s.use_tool("soil") and s.d.craft.soil==1,"first soil half fill")
	check(not s.use_tool("soil"),"cannot cover before planting")
	check(not s.place("freesia",Vector2(.1,.2)),"outside pot rejected")
	check(s.place("freesia",Vector2(.45,.4)) and s.place("lovemis",Vector2(.55,.4)),"two flowers planted")
	check(not s.place("yellow",Vector2(.5,.4)),"third pot flower rejected")
	check(s.use_tool("soil") and s.d.craft.soil==2,"cover planted flowers")
	check(not s.use_tool("soil"),"no third soil action")
	check(s.use_tool("ribbon") and s.deliver() and s.d.mastery.love_pot==1,"pot ribbon and delivery")
	check(s.valid(s.snapshot()),"post-delivery state valid")
	s.end_day(); s.next_day(); s.start_day(); s.accept_order(); s.setup("bouquet")
	var before:int=s.d.inventory.yellow
	s.place("yellow",Vector2(.3,.3));s.tick(5);s.reset_craft()
	check(s.d.inventory.yellow==before and s.d.patience==5,"undo returns exactly one flower and keeps timer")
	s.reset_craft()
	check(s.d.inventory.yellow==before,"undo idempotence")
	s.setup("bouquet");s.place("yellow",Vector2(.3,.3))
	s.paused=true;s.tick(200)
	check(s.d.patience==5 and not s.use_tool("ribbon"),"pause freezes timers and crafting")
	s.paused=false;s.tick(115)
	check(s.d.phase=="waiting" and s.d.missed==1 and s.d.inventory.yellow==before,"timeout dismisses and refunds working flowers")
	s.tick(4)
	s.d.elapsed=479;s.tick(3)
	check(s.d.phase=="closed" and s.d.elapsed==480,"day auto closes")
	var farm=State.new()
	check(not farm.plant(2,"freesia") and farm.unlock_plot(2),"locked plot enforced")
	check(not farm.unlock_plot(2),"no double purchase")
	check(farm.plant(0,"freesia") and farm.water(0) and farm.fertilize(0),"plant water fertilizer")
	check(not farm.plant(0,"yellow") and not farm.water(0) and not farm.fertilize(0),"plot cannot be overwritten or double-used")
	farm.tick(400)
	check(farm.d.plots[0].growth==0,"no pre-opening growth")
	farm.start_day();farm.tick(100)
	check(farm.d.plots[0].growth==150 and not farm.harvest(0),"fertilized game-time growth")
	farm.tick(140)
	var initial:int=farm.d.inventory.freesia
	check(farm.harvest(0) and farm.d.inventory.freesia>=initial+2 and farm.d.inventory.freesia<=initial+4,"harvest range")
	check(not farm.harvest(0),"harvest once")
	check(not farm.claim("birthday"),"no early mastery reward")
	farm.d.mastery.birthday=10
	var money:int=farm.d.gold
	check(farm.claim("birthday") and farm.d.gold==money+100 and not farm.claim("birthday"),"mastery reward exactly once")
	for bad in [["gold",-1],["gold",1.5],["phase","invalid"],["elapsed",INF],["plots",[]],["inventory",{}],["current",90]]:
		var data:Dictionary=s.snapshot();data[bad[0]]=bad[1]
		check(not s.valid(data),"reject invalid "+bad[0])
	var old=Legacy.new()
	old.gold=777;old.accept_order();old.select_flower("rose");old.select_flower("rose");old.select_flower("daisy");old.craft_step()
	old.plant(0,"moon");old.water(0);old.tick(5)
	var migrated=State.new()
	check(migrated.restore(old.snapshot()) and migrated.d.gold==777 and migrated.d.inventory.redflora==3 and migrated.d.inventory.yellow==3,"legacy gold and reserved ingredients retained")
	check(migrated.d.phase=="ready" and migrated.d.plots[0].flower=="lovemis" and is_equal_approx(migrated.d.plots[0].growth,80.0),"legacy growth fraction migrated")
	var path:String=ProjectSettings.globalize_path("res://../../work/v2-save-tests")
	DirAccess.make_dir_recursive_absolute(path)
	var base:String=path+"/run-"+str(Time.get_ticks_usec())
	var store=Store.new(base)
	check(store.save(migrated),"save migrated v2")
	var loaded=State.new()
	check(store.load_into(loaded) and loaded.d.gold==777 and loaded.d.inventory==migrated.d.inventory,"restore v2")
	migrated.d.gold+=1;check(store.save(migrated),"backup rotation")
	var badfile:FileAccess=FileAccess.open_encrypted_with_pass(base+".sav",FileAccess.WRITE,Store.PASSWORD)
	badfile.store_string(JSON.stringify({"body":JSON.stringify(migrated.snapshot()),"signature":"wrong"}));badfile.close()
	check(Store.new(base).load_into(loaded) and loaded.d.gold==777,"signature mismatch recovers prior backup")
	var legacy_base:String=base+"-legacy"
	var legacy_store=Store.new(legacy_base)
	check(legacy_store.save(old),"write valid legacy fixture")
	check(legacy_store.load_into(loaded) and loaded.d.gold==777 and FileAccess.file_exists(legacy_base+".v1-original"),"original v1 preserved before migration")
	var backup_base:String=base+"-legacy-backup"
	DirAccess.copy_absolute(legacy_base+".sav",backup_base+".bak")
	check(Store.new(backup_base).load_into(loaded) and FileAccess.file_exists(backup_base+".v1-original"),"legacy backup original preserved before migration")
	var working=State.new()
	working.start_day();working.accept_order();working.setup("bouquet")
	working.place("freesia",Vector2(.3,.3));working.trim([0]);working.tick(17)
	var work_store=Store.new(base+"-working")
	check(work_store.save(working) and work_store.load_into(loaded),"save and reload unfinished crafting")
	check(loaded.d.craft.items.size()==1 and loaded.d.craft.items[0].trimmed and loaded.d.patience==17 and loaded.d.inventory.freesia==5,"unfinished flower timer and stock retained")
	loaded.reset_craft()
	check(loaded.d.inventory.freesia==6,"undo after reload refunds exactly once")
	var broken_base:String=base+"-broken"
	for suffix in [".sav",".bak"]:
		var file:FileAccess=FileAccess.open_encrypted_with_pass(broken_base+suffix,FileAccess.WRITE,Store.PASSWORD)
		file.store_string("{}");file.close()
	var bytes:PackedByteArray=FileAccess.get_file_as_bytes(broken_base+".sav")
	var broken=Store.new(broken_base)
	check(not broken.load_into(loaded) and not broken.writable and not broken.save(loaded),"both corrupt slots disable saves")
	check(FileAccess.get_file_as_bytes(broken_base+".sav")==bytes,"unreadable original preserved untouched")
	for id in s.content.assets:
		var texture:Texture2D=s.content.texture(id)
		check(texture!=null and texture.get_width()==s.content.assets[id].width and texture.get_height()==s.content.assets[id].height,"asset "+id)
	print("V2_TEST_RESULT checks=%d failures=%d"%[checks,failures])
	quit(0 if failures==0 else 1)
