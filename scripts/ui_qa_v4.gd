extends "res://scripts/ui_qa_v3.gd"
func run(root:Control) -> void:
	game=root
	output=ProjectSettings.globalize_path("res://../../work/v4-ui")
	for arg in OS.get_cmdline_user_args():
		if arg.begins_with("--qa-output="):output=arg.trim_prefix("--qa-output=")
	DirAccess.make_dir_recursive_absolute(output)
	await settle()
	game._show_tutorial();await settle();await named("BookClose")
	check(game.state.d.tutorial_done,"tutorial acknowledged")
	await named("Clock");check(game.state.d.phase=="talk","clock starts day")
	await named("Ask");await named("Ask");await capture("01-counter")
	check(game.find_child("Book",true,false).position.x>game.size.x*.6,"book lower right")
	await named("Accept");await named("OrderBookmark");await capture("02-order")
	check(game.popup.position.x==0,"order drawer left edge")
	await press("주문서 접기")
	await named("Nav_atelier");await named("Paper")
	await shelf_drop("yellow",Vector2(.01,.01));check(game.state.d.inventory.yellow==5,"invalid placement refunds")
	# Regression: already overlapping in paper center, no hand movement at all.
	for i in 5:await shelf_drop("yellow",Vector2(.5,.60))
	check(game.state.d.craft.items.size()==5,"five actual shelf drags")
	if game.state.d.craft.items.size()!=5:finish();return
	await named("Tool_wire");await click(game.board.global_position+game.board.size*Vector2(.5,.6))
	check(game.state.d.craft.step=="placing","wire cannot skip trimming")
	await named("Tool_scissors")
	var at:Vector2=game.board.global_position+game.board.leaf_rect(0).get_center()
	await drag(at-Vector2(35,0),at+Vector2(35,0))
	check(game.state.d.craft.items.all(func(item):return item.trimmed),"overlapping five flowers trimmed in same stroke")
	check(game.state.can_tie(),"already centered cluster ready without dragging")
	await named("Tool_wire");await named("Tool_wire")
	check(game.tool=="wire","reselect wire stays selected")
	await capture("03-atelier")
	await click(game.board.global_position+game.board.size*Vector2(.85,.80))
	check(game.state.d.craft.step=="tied","off-center paper click binds centered flowers")
	await named("Tool_ribbon");await click(game.board.global_position+game.board.size*Vector2(.5,.65))
	check(game.room=="shop" and game.state.d.craft.step=="complete","ribbon completes")
	await named("Deliver");check(game.state.d.total_sales==1,"delivered through pointer")
	await capture("04-payment");await named("Farewell")
	await named("Nav_garden");await named("Plot_0");await named("Plot_0")
	check(game.state.d.plots[0].watered,"plant and water actual click")
	await capture("05-garden")
	await named("Book");await named("Tab_flowers");await capture("06-flowers")
	await named("Tab_regulars");await capture("07-regulars");await named("NextPage");check(game.menus.page==1,"regular next page");await named("PreviousPage");check(game.menus.page==0,"regular previous page")
	await named("BookClose");await named("Nav_shop")
	await named("Store");await named("BuySeed_yellow");check(game.state.d.seeds.yellow>=3,"store seed purchase")
	await named("BookClose")
	# Layout fixtures: reveal catalog and regular profiles, without advancing real saves.
	game.state.d.discovered=game.state.content.catalog.flowers.keys()
	for npc in game.state.world.npcs:game.state.d.met_npcs.append(npc.id)
	game.state.d.relationships.sentinel=5
	await named("Book");await named("Tab_flowers");await capture("08-flowers-known")
	await named("Tab_regulars");await capture("09-regulars-known")
	await named("BookClose")
	game.state.d.phase="order";game.state.d.current=0;game.state.d.order_recipe="friendship";game.state.d.craft=game.state.blank_craft();game.state.d.inventory.yellow=5;game.state.notify();await settle()
	await named("Nav_atelier");await named("Paper");await capture("10-shelf")
	# Pot and other menu actions after the spatial UI rewrite.
	await named("Undo");game.state.d.day=2;game.state.d.inventory.freesia=1;game.state.d.inventory.lovemis=1;game.state.d.order_recipe="love_pot";game.state.notify();await settle()
	await named("Pot");await named("Tool_soil");await click(game.board.global_position+game.board.size*Vector2(.5,.6))
	await shelf_drop("freesia",Vector2(.45,.4));await shelf_drop("lovemis",Vector2(.55,.4))
	await named("Tool_soil");await click(game.board.global_position+game.board.size*Vector2(.5,.6))
	await named("Tool_ribbon");await click(game.board.global_position+game.board.size*Vector2(.5,.6))
	check(game.state.d.craft.step=="complete","pot completed using bottom tools")
	await named("Deliver");check(game.state.d.pots_sold==1,"pot delivered")
	await named("Store");await named("BuyDecor_wall_garden");await press("꾸미기");await named("Color_wall_garden_1");await named("Equip_wall_garden")
	check(game.state.d.equipped.wall.id=="wall_garden" and game.state.d.equipped.wall.color==1,"decor purchase color and equip")
	await named("BookClose");await capture("11-decor-counter")
	await named("Settings");await press("큰 본문 글자");await named("Tab_regulars");await capture("12-large-text-book");await named("BookClose")
	print("V4_UI_RESULT errors=%d"%errors)
	game.get_tree().quit(0 if errors==0 else 1)
